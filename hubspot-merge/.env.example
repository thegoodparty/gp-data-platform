# Databricks connection: the same variables the DAGs already set for reverse-etl, from
# the `databricks` / `databricks_dev` Airflow connection. OAuth M2M only -- there is no
# token path, since the job runs as a service principal in both deployments.
DATABRICKS_HOST=
DATABRICKS_HTTP_PATH=
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=
# OAuth scopes the M2M token requests, comma or space separated. Must be a subset of what
# the service principal's secret was minted with. Unset requests the SDK default of
# `all-apis`, which a narrowed service principal will refuse.
DATABRICKS_SCOPES=

# A private app's token, scoped crm.objects.contacts.read and crm.objects.contacts.write.
HUBSPOT_TOKEN=
# HUBSPOT_BASE_URL=https://api.hubapi.com
# A service key carries no portal in its text, so every run asks HubSpot which portal it
# is writing to and refuses to merge unless it matches this.
HUBSPOT_EXPECTED_PORTAL_ID=

# contacts is the only accepted value until Companies are supported. The log records it
# so that increment needs no schema change.
MERGE_OBJECT_TYPE=contacts
# The queue view: the job's whole input. A sandbox run, a narrowed production run and the
# scheduled run differ only here.
MERGE_PAIR_RELATION=
# Append-only log table in an ingest schema. Production and dev are separated by schema,
# not by table name.
MERGE_LOG_TABLE=goodparty_data_catalog.airflow_source_dev.hubspot_contact_merge_log
# Pairs read per run. Plenty of pairs are left behind when the cap is hit; the next run
# reads them, since the queue drops whatever is already logged.
MERGE_MAX_PAIRS=
# Merge calls per second. One pair per call, and the burst limit is per app, so this is
# the whole pacing surface.
MERGE_MAX_RPS=
