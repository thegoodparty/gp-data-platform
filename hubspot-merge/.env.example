# The same Databricks variables the DAGs already set for reverse-etl, from the
# `databricks` / `databricks_dev` Airflow connection. For a hand run, leave the client id
# and secret unset and log in with `databricks auth login --host $DATABRICKS_HOST`.
DATABRICKS_HOST=
DATABRICKS_HTTP_PATH=
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=
# Must be a subset of what the service principal's secret was minted with; unset requests
# the SDK default of `all-apis`, which a narrowed principal refuses.
DATABRICKS_SCOPES=

# A service key, scoped crm.objects.contacts.read and crm.objects.contacts.write.
HUBSPOT_TOKEN=
# HUBSPOT_BASE_URL=https://api.hubapi.com
# A service key carries no portal in its text, so every run confirms which portal it
# writes to and refuses to merge unless it matches this.
HUBSPOT_EXPECTED_PORTAL_ID=

# The only accepted value until Companies are supported; the log records it so that
# increment needs no schema change.
MERGE_OBJECT_TYPE=contacts
# The queue view: the job's whole input. A sandbox run, a narrowed production run and the
# scheduled run differ only here.
MERGE_PAIR_RELATION=
# Append-only log table in an ingest schema; production and dev differ by schema.
MERGE_LOG_TABLE=goodparty_data_catalog.airflow_source_dev.hubspot_contact_merge_log
# Pairs read per run. What the cap leaves behind, the next run reads, since the queue drops
# whatever is already logged.
MERGE_MAX_PAIRS=
# Merge calls per second. One pair per call, and the burst limit is per app.
MERGE_MAX_RPS=
