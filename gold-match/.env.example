# Runtime configuration for the matcher CLI; the tests need none of these.
# ENVIRONMENT drives shared/logger.py's level: production/prod = INFO,
# development/dev/debug = DEBUG, unset = WARNING -- which hides the run's
# operator-facing progress, summary, and cost output.
ENVIRONMENT=development
DATABRICKS_SERVER_HOSTNAME=hostname
DATABRICKS_HTTP_PATH=path
DATABRICKS_API_KEY=key
GEMINI_API_KEY=key
# Optional: unset disables Braintrust tracing cleanly.
BRAINTRUST_API_KEY=key
# AWS (Bedrock model calls): boto3's default credential chain; for local
# runs use an SSO profile. Region is set in the clients (us-east-1).
AWS_PROFILE=gp-engineer
