# Runtime configuration for the matcher CLI; the tests need none of these.
# ENVIRONMENT drives shared/logger.py's level: production/prod = INFO,
# development/dev/debug = DEBUG, unset = WARNING -- which hides the run's
# operator-facing progress, summary, and cost output.
ENVIRONMENT=development
DATABRICKS_SERVER_HOSTNAME=hostname
DATABRICKS_HTTP_PATH=path
# Either the PAT below (local dev; retires with the personal token ~2026-11)
# or the M2M service-principal pair (what the scheduled pod runs with).
DATABRICKS_API_KEY=key
DATABRICKS_CLIENT_ID=client-id
DATABRICKS_CLIENT_SECRET=client-secret
GEMINI_API_KEY=key
# Optional: unset disables Braintrust tracing cleanly.
BRAINTRUST_API_KEY=key
# AWS (Bedrock model calls): boto3's default credential chain; for local
# runs use an SSO profile. Region is set in the clients (us-east-1).
AWS_PROFILE=gp-engineer
# backlog_run.py rollback only: triggers the scheduled dbt rebuild.
DBT_CLOUD_BASE_URL=host
DBT_CLOUD_ACCOUNT_ID=account
DBT_CLOUD_API_TOKEN=token
# backlog_run.py rollback --published only: re-triggers the PostgreSQL sync.
# A short-TTL deployment token, not a long-lived secret.
AIRFLOW_API_BASE_URL=host
AIRFLOW_API_TOKEN=token
