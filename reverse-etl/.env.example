# Databricks connection. Either DATABRICKS_TOKEN, or DATABRICKS_CLIENT_ID +
# DATABRICKS_CLIENT_SECRET for OAuth M2M (the same shape the loader DAG already
# passes through the environment at task runtime; retl never reads an Airflow
# Variable or Connection directly).
DATABRICKS_HOST=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=
# DATABRICKS_CLIENT_ID=
# DATABRICKS_CLIENT_SECRET=

# Per-flow config, namespaced RETL_FLOW_<FLOW_ID>_*. `hubspot` is the first flow: one
# contact sync carrying every property we own, not a lead feed, so a new attribute is
# a column on its model rather than a second flow. The tests use other names on
# purpose -- a real deployment may use any name and add more flows the same way, with
# no code change. Each flow owns its own
# three-column log table (tracking_key, payload, sent_at) -- `retl --init-log`
# creates and stamps it with this flow's id (TBLPROPERTIES 'retl.flow_id'), which
# every run then verifies before trusting a row; point a sandbox or local run at a
# scratch table here instead of the production one. Table names follow
# sent_log_<flow_id>, so a future cross-flow audit view can derive the flow name
# from the table name mechanically; sandbox/scratch runs override this value, not
# the convention.
RETL_FLOW_HUBSPOT_SOURCE_RELATION=
RETL_FLOW_HUBSPOT_KEY_COLUMN=gp_person_id
RETL_FLOW_HUBSPOT_EXCLUDED_COLUMNS=
RETL_FLOW_HUBSPOT_CAP=
RETL_FLOW_HUBSPOT_LOG_TABLE=goodparty_data_catalog.reverse_etl.sent_log_hubspot

# --destination hubspot_contacts. Needs a private-app token scoped for
# crm.objects.contacts.write (batch upsert); confirm the exact scope list against
# the sandbox private app before enable.
RETL_HUBSPOT_TOKEN=
# RETL_HUBSPOT_BASE_URL=https://api.hubapi.com

# --destination csv
RETL_CSV_OUTPUT_PATH=
