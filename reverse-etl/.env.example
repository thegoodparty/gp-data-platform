# Databricks connection. Either DATABRICKS_TOKEN, or DATABRICKS_CLIENT_ID +
# DATABRICKS_CLIENT_SECRET for OAuth M2M (the same shape the loader DAG already
# passes through the environment at task runtime; retl never reads an Airflow
# Variable or Connection directly).
DATABRICKS_HOST=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=
# DATABRICKS_CLIENT_ID=
# DATABRICKS_CLIENT_SECRET=

# Which sent_log-shaped table this run reads and (for a logging destination) appends
# to. Point this at a scratch-schema table for a sandbox or local run; only a
# production HubSpot destination should ever point it at the production table.
RETL_LOG_TABLE=goodparty_data_catalog.reverse_etl.sent_log

# Per-flow config, namespaced RETL_FLOW_<FLOW_ID>_*. hubspot_leads is the flow this
# repo names in its worked examples; a real deployment may use a different name and
# add more flows the same way, with no code change.
RETL_FLOW_HUBSPOT_LEADS_SOURCE_RELATION=
RETL_FLOW_HUBSPOT_LEADS_KEY_COLUMN=gp_person_id
RETL_FLOW_HUBSPOT_LEADS_EXCLUDED_COLUMNS=
RETL_FLOW_HUBSPOT_LEADS_CAP=

# --destination hubspot_contacts. Needs a private-app token scoped for
# crm.objects.contacts.write (batch upsert); confirm the exact scope list against
# the sandbox private app before enable.
RETL_HUBSPOT_TOKEN=
# RETL_HUBSPOT_BASE_URL=https://api.hubapi.com

# --destination csv
RETL_CSV_OUTPUT_PATH=
